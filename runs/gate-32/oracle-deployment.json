{
  "gate": 32,
  "provider": "Oracle Cloud Infrastructure",
  "region": "eu-frankfurt-1",
  "architecture": "arm64",
  "service": "multimodal-studio",
  "binding": "127.0.0.1:8091",
  "health_endpoint": "/healthz",
